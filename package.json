{
  "name": "coding-interviews-platform",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "test": "npm run test:all",
    "test:backend": "npm test --prefix backend",
    "test:frontend": "npm test --prefix frontend",
    "test:integration": "npm test --prefix backend -- client-server.integration.test.js",
    "test:all": "npm run test:backend && npm run test:frontend",
    "build": "npm run build --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "test:e2e": "npm run test:e2e --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
